{
  "name": "medicloud-functions",
  "private": true,
  "main": "src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "serve": "firebase emulators:start --only functions,firestore,auth,storage",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:emulator": "firebase emulators:exec --only functions,firestore,auth,storage \"node --test --test-concurrency=1 \\\"test/emulator/*.test.js\\\"\"",
    "provision:admin": "node scripts/provisionAdmin.js",
    "seed": "node scripts/seedReference.js",
    "emulator:setup": "node scripts/emulatorSetup.js"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0"
  }
}